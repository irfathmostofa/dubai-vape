# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key for Resend transactional email delivery.
# Configure via AI Studio Secrets panel to send live order confirmation & dispatch emails.
RESEND_API_KEY="re_123456789_example"
RESEND_FROM_EMAIL="Vape Dubai King <orders@vapedubaiking.ae>"
